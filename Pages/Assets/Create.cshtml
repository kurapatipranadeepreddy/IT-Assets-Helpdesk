@page
@model ITAssetHelpdesk.Pages.Assets.CreateModel
@{ ViewData["Title"] = "Add Asset"; }
<div class="page-header">
    <h2><i class="bi bi-plus-circle me-2"></i>Add Asset</h2>
    <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>
<div class="form-card" style="max-width:880px;">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-600">Asset Tag *</label>
                <input asp-for="Asset.AssetTag" class="form-control" required/>
                <span asp-validation-for="Asset.AssetTag" class="text-danger small"></span>
            </div>
            <div class="col-md-5">
                <label class="form-label fw-600">Asset Name *</label>
                <input asp-for="Asset.Name" class="form-control" placeholder="e.g. Dell XPS 15 Laptop" required/>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-600">Category *</label>
                <select asp-for="Asset.Category" class="form-select" required>
                    @foreach (var c in ITAssetHelpdesk.Models.Asset.Categories)
                    { <option value="@c">@c</option> }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-600">Brand</label>
                <input asp-for="Asset.Brand" class="form-control" placeholder="Dell, HP, Apple…"/>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-600">Model</label>
                <input asp-for="Asset.Model" class="form-control"/>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-600">Serial Number</label>
                <input asp-for="Asset.SerialNumber" class="form-control"/>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-600">Status *</label>
                <select asp-for="Asset.Status" class="form-select">
                    @foreach (var s in ITAssetHelpdesk.Models.Asset.Statuses)
                    { <option value="@s">@s</option> }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-600">Purchase Date</label>
                <input asp-for="Asset.PurchaseDate" type="date" class="form-control"/>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-600">Warranty Expiry</label>
                <input asp-for="Asset.WarrantyExpiryDate" type="date" class="form-control"/>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-600">Cost ($)</label>
                <input asp-for="Asset.Cost" type="number" step="0.01" min="0" class="form-control" placeholder="0.00"/>
            </div>
            <div class="col-md-8">
                <label class="form-label fw-600">Location</label>
                <input asp-for="Asset.Location" class="form-control" placeholder="Office room, desk, storage…"/>
            </div>
            <div class="col-12">
                <label class="form-label fw-600">Notes</label>
                <textarea asp-for="Asset.Notes" class="form-control" rows="2" placeholder="Additional notes…"></textarea>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4 pt-3 border-top">
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i>Add Asset</button>
            <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
