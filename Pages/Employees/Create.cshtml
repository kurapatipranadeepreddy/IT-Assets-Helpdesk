@page
@model ITAssetHelpdesk.Pages.Employees.CreateModel
@{ ViewData["Title"] = "Add Employee"; }
<div class="page-header">
    <h2><i class="bi bi-person-plus me-2"></i>Add Employee</h2>
    <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>
<div class="form-card" style="max-width:760px;">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-600">Employee Code *</label>
                <input asp-for="Employee.EmployeeCode" class="form-control" required/>
                <span asp-validation-for="Employee.EmployeeCode" class="text-danger small"></span>
            </div>
            <div class="col-md-8">
                <label class="form-label fw-600">Full Name *</label>
                <input asp-for="Employee.FullName" class="form-control" placeholder="First and Last name" required/>
                <span asp-validation-for="Employee.FullName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-600">Email Address *</label>
                <input asp-for="Employee.Email" type="email" class="form-control" required/>
                <span asp-validation-for="Employee.Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-600">Phone</label>
                <input asp-for="Employee.Phone" class="form-control" placeholder="+1-555-0100"/>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-600">Department *</label>
                <input asp-for="Employee.Department" class="form-control" list="depts" required/>
                <datalist id="depts">
                    <option>IT</option><option>HR</option><option>Finance</option>
                    <option>Marketing</option><option>Sales</option><option>Operations</option>
                </datalist>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-600">Job Title *</label>
                <input asp-for="Employee.JobTitle" class="form-control" required/>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-600">Date Joined *</label>
                <input asp-for="Employee.DateJoined" type="date" class="form-control" required/>
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check form-switch mb-2">
                    <input asp-for="Employee.IsActive" class="form-check-input" role="switch" checked/>
                    <label asp-for="Employee.IsActive" class="form-check-label fw-600">Active</label>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4 pt-3 border-top">
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i>Add Employee</button>
            <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
