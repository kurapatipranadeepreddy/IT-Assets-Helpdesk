@page "{id:int}"
@model ITAssetHelpdesk.Pages.Employees.EditModel
@{ ViewData["Title"] = "Edit Employee"; }
<div class="page-header">
    <h2><i class="bi bi-pencil me-2"></i>Edit Employee</h2>
    <div class="d-flex gap-2">
        <a asp-page="./Details" asp-route-id="@Model.Employee.Id" class="btn btn-outline-secondary"><i class="bi bi-eye me-1"></i>View</a>
        <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>
<div class="form-card" style="max-width:760px;">
    <form method="post">
        <input type="hidden" asp-for="Employee.Id"/>
        <input type="hidden" asp-for="Employee.EmployeeCode"/>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-600">Employee Code</label>
                <input class="form-control bg-light" value="@Model.Employee.EmployeeCode" readonly/>
            </div>
            <div class="col-md-8">
                <label class="form-label fw-600">Full Name *</label>
                <input asp-for="Employee.FullName" class="form-control" required/>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-600">Email Address *</label>
                <input asp-for="Employee.Email" type="email" class="form-control" required/>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-600">Phone</label>
                <input asp-for="Employee.Phone" class="form-control"/>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-600">Department *</label>
                <input asp-for="Employee.Department" class="form-control" list="depts" required/>
                <datalist id="depts"><option>IT</option><option>HR</option><option>Finance</option><option>Marketing</option><option>Sales</option><option>Operations</option></datalist>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-600">Job Title *</label>
                <input asp-for="Employee.JobTitle" class="form-control" required/>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-600">Date Joined</label>
                <input asp-for="Employee.DateJoined" type="date" class="form-control"/>
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check form-switch mb-2">
                    <input asp-for="Employee.IsActive" class="form-check-input" role="switch"/>
                    <label asp-for="Employee.IsActive" class="form-check-label fw-600">Active</label>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4 pt-3 border-top">
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i>Save Changes</button>
            <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
