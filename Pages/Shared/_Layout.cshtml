<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — " : "")IT Asset & Helpdesk</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>

@{
    var isLoggedIn = Context.Session.GetString("UserId") != null;
    var currentPage = ViewContext.RouteData.Values["Page"]?.ToString() ?? "";
}

@if (isLoggedIn)
{
<div class="app-wrapper">
    <!-- Sidebar -->
    <nav class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon"><i class="bi bi-cpu"></i></div>
            <div class="brand-text">
                <span class="brand-name">IT Helpdesk</span>
                <span class="brand-sub">Management System</span>
            </div>
        </div>

        <ul class="sidebar-nav">
            <li class="nav-section-label">MAIN</li>
            <li class="@(currentPage == "/Dashboard/Index" || currentPage == "/Dashboard" ? "active" : "")">
                <a asp-page="/Dashboard/Index"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
            </li>
            <li class="nav-section-label">ASSETS</li>
            <li class="@(currentPage.StartsWith("/Assets") ? "active" : "")">
                <a asp-page="/Assets/Index"><i class="bi bi-box-seam"></i><span>Assets</span></a>
            </li>
            <li class="@(currentPage.StartsWith("/Employees") ? "active" : "")">
                <a asp-page="/Employees/Index"><i class="bi bi-people"></i><span>Employees</span></a>
            </li>
            <li class="nav-section-label">HELPDESK</li>
            <li class="@(currentPage.StartsWith("/Tickets") ? "active" : "")">
                <a asp-page="/Tickets/Index"><i class="bi bi-ticket-perforated"></i><span>Tickets</span></a>
            </li>
            <li class="nav-section-label">REPORTS</li>
            <li class="@(currentPage.StartsWith("/Reports") ? "active" : "")">
                <a asp-page="/Reports/Index"><i class="bi bi-bar-chart-line"></i><span>Reports</span></a>
            </li>
        </ul>

        <div class="sidebar-footer">
            <div class="user-info">
                <div class="user-avatar">@((Context.Session.GetString("UserName") ?? "U")[0].ToString().ToUpper())</div>
                <div class="user-details">
                    <span class="user-name">@Context.Session.GetString("UserName")</span>
                    <span class="user-role">@Context.Session.GetString("UserRole")</span>
                </div>
            </div>
            <a asp-page="/Logout" class="btn-signout" title="Sign out"><i class="bi bi-box-arrow-right"></i></a>
        </div>
    </nav>

    <!-- Main content -->
    <div class="main-content">
        <header class="topbar">
            <button class="sidebar-toggle" id="sidebarToggle"><i class="bi bi-list"></i></button>
            <div class="topbar-title">
                <h1 class="page-title">@(ViewData["Title"] ?? "Dashboard")</h1>
            </div>
            <div class="topbar-right">
                <span class="topbar-date" id="topbarDate"></span>
                @if (Context.Session.GetString("UserRole") == "Administrator")
                {
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Admin</span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Technician</span>
                }
            </div>
        </header>

        <div class="content-area">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>
</div>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
