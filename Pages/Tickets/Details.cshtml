@page "{id:int}"
@model ITAssetHelpdesk.Pages.Tickets.DetailsModel
@{
    var t = Model.Ticket;
    ViewData["Title"] = t.TicketNumber;
    var sc = t.Status switch {"Open"=>"badge-open","In Progress"=>"badge-inprogress","Waiting for User"=>"badge-waiting","Resolved"=>"badge-resolved","Closed"=>"badge-closed",_=>""};
    var pc = t.Priority switch {"Low"=>"badge-low","Medium"=>"badge-medium","High"=>"badge-high","Critical"=>"badge-critical",_=>""};
}

<div class="page-header">
    <h2><i class="bi bi-ticket-perforated me-2"></i>@t.TicketNumber</h2>
    <div class="d-flex gap-2">
        <a asp-page="./Edit" asp-route-id="@t.Id" class="btn btn-outline-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="detail-header">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <span class="badge-status @pc" style="font-size:13px;">@t.Priority</span>
                    <span class="badge-status @sc" style="font-size:13px;">@t.Status</span>
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" style="font-size:12px;">@t.Category</span>
                </div>
                <h3 style="color:#f1f5f9;margin:0;font-size:20px;">@t.Title</h3>
            </div>
            <div class="p-4">
                <p class="form-section-title mb-2">Description</p>
                <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:16px;font-size:14px;line-height:1.7;white-space:pre-wrap;">@t.Description</div>
                @if (!string.IsNullOrEmpty(t.ResolutionNotes))
                {
                    <div class="p-3 rounded-3 mt-3" style="background:#f0fdf4;border:1px solid #bbf7d0;">
                        <p class="fw-700 text-success mb-2" style="font-size:13px;"><i class="bi bi-check-circle-fill me-1"></i>Resolution Notes</p>
                        <p style="font-size:14px;margin:0;white-space:pre-wrap;">@t.ResolutionNotes</p>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header-custom"><h5><i class="bi bi-gear me-2"></i>Workflow Actions</h5></div>
            <div class="p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <p class="form-section-title">Assign Technician</p>
                        <form method="post" asp-page-handler="AssignTech" asp-route-id="@t.Id" class="d-flex gap-2">
                            <select name="TechId" class="form-select">
                                @foreach (var u in Model.Technicians)
                                {
                                    if (u.Id == t.AssignedTechnicianId) { <option value="@u.Id" selected>@u.FullName</option> }
                                    else { <option value="@u.Id">@u.FullName</option> }
                                }
                            </select>
                            <button type="submit" class="btn btn-primary btn-sm px-3 flex-shrink-0"><i class="bi bi-check-lg"></i></button>
                        </form>
                    </div>
                    <div class="col-md-6">
                        <p class="form-section-title">Change Status</p>
                        <form method="post" asp-page-handler="ChangeStatus" asp-route-id="@t.Id">
                            <div class="d-flex gap-2 mb-2">
                                <select name="NewStatus" class="form-select">
                                    @foreach (var s in ITAssetHelpdesk.Models.Ticket.Statuses)
                                    {
                                        if (s == t.Status) { <option value="@s" selected>@s</option> }
                                        else { <option value="@s">@s</option> }
                                    }
                                </select>
                                <button type="submit" class="btn btn-outline-primary btn-sm px-3 flex-shrink-0"><i class="bi bi-arrow-right-circle"></i></button>
                            </div>
                            @if (t.Status != "Resolved")
                            {
                                <input name="ResNotes" class="form-control form-control-sm" placeholder="Resolution notes (required for Resolved)"/>
                            }
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header-custom"><h5><i class="bi bi-info-circle me-2"></i>Ticket Info</h5></div>
            <div class="p-3">
                @{
                    var rows = new (string Label, string Value)[]
                    {
                        ("Ticket #", t.TicketNumber),
                        ("Created By", t.CreatedBy.FullName),
                        ("Technician", t.AssignedTechnician?.FullName ?? "Unassigned"),
                        ("Created", t.CreatedDate.ToString("MMM dd, yyyy HH:mm")),
                        ("Last Updated", t.UpdatedDate.ToString("MMM dd, yyyy HH:mm")),
                    };
                }
                @foreach (var r in rows)
                {
                    <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #f1f5f9;">
                        <span style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.04em;">@r.Label</span>
                        <span style="font-size:13px;color:#0f172a;">@r.Value</span>
                    </div>
                }
                @if (t.ResolvedDate.HasValue)
                {
                    <div style="display:flex;justify-content:space-between;padding:8px 0;">
                        <span style="font-size:11px;font-weight:700;color:#16a34a;text-transform:uppercase;">Resolved</span>
                        <span style="font-size:13px;">@t.ResolvedDate.Value.ToString("MMM dd, yyyy")</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
