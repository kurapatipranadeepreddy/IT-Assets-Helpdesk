@page
@model ITAssetHelpdesk.Pages.Tickets.IndexModel
@{
    ViewData["Title"] = "Helpdesk Tickets";
    var isAdmin = HttpContext.Session.GetString("UserRole") == "Administrator";
}

<div class="page-header">
    <h2><i class="bi bi-ticket-perforated me-2"></i>Helpdesk Tickets</h2>
    <a asp-page="./Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New Ticket</a>
</div>

<div class="table-card">
    <div class="table-toolbar">
        <form method="get" class="d-flex gap-2 flex-wrap w-100 align-items-center">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" name="Search" class="form-control" placeholder="Search tickets..."
                       value="@Model.Search" style="width:200px;padding-left:32px;"/>
            </div>
            <select name="Status" class="form-select" style="width:155px;">
                <option value="">All Statuses</option>
                @foreach (var s in ITAssetHelpdesk.Models.Ticket.Statuses)
                {
                    if (Model.Status == s) { <option value="@s" selected>@s</option> }
                    else { <option value="@s">@s</option> }
                }
            </select>
            <select name="Priority" class="form-select" style="width:130px;">
                <option value="">All Priorities</option>
                @foreach (var p in ITAssetHelpdesk.Models.Ticket.Priorities)
                {
                    if (Model.Priority == p) { <option value="@p" selected>@p</option> }
                    else { <option value="@p">@p</option> }
                }
            </select>
            <select name="Category" class="form-select" style="width:150px;">
                <option value="">All Categories</option>
                @foreach (var c in ITAssetHelpdesk.Models.Ticket.Categories)
                {
                    if (Model.Category == c) { <option value="@c" selected>@c</option> }
                    else { <option value="@c">@c</option> }
                }
            </select>
            <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-funnel me-1"></i>Filter</button>
            @if (Model.Search!=null||Model.Status!=null||Model.Priority!=null||Model.Category!=null)
            { <a asp-page="./Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x me-1"></i>Clear</a> }
            <span class="ms-auto text-muted-sm">@Model.Tickets.Count ticket(s)</span>
        </form>
    </div>

    <div class="table-responsive">
        <table class="styled">
            <thead>
                <tr><th>Ticket #</th><th>Title</th><th>Category</th><th>Priority</th><th>Status</th><th>Technician</th><th>Created</th><th>Updated</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Tickets)
                {
                    var sc = t.Status switch { "Open"=>"badge-open","In Progress"=>"badge-inprogress","Waiting for User"=>"badge-waiting","Resolved"=>"badge-resolved","Closed"=>"badge-closed",_=>"" };
                    var pc = t.Priority switch { "Low"=>"badge-low","Medium"=>"badge-medium","High"=>"badge-high","Critical"=>"badge-critical",_=>"" };
                    <tr>
                        <td><a asp-page="./Details" asp-route-id="@t.Id" class="fw-600 text-primary">@t.TicketNumber</a></td>
                        <td><a asp-page="./Details" asp-route-id="@t.Id" class="text-dark">@t.Title</a></td>
                        <td>@t.Category</td>
                        <td><span class="badge-status @pc">@t.Priority</span></td>
                        <td><span class="badge-status @sc">@t.Status</span></td>
                        <td>@(t.AssignedTechnician?.FullName ?? "Unassigned")</td>
                        <td class="text-muted-sm">@t.CreatedDate.ToString("MMM dd")</td>
                        <td class="text-muted-sm">@t.UpdatedDate.ToString("MMM dd")</td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-page="./Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary" title="View"><i class="bi bi-eye"></i></a>
                                <a asp-page="./Edit"    asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary"   title="Edit"><i class="bi bi-pencil"></i></a>
                                @if (isAdmin)
                                {
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@t.Id" class="d-inline"
                                          onsubmit="return confirm('Delete ticket?')">
                                        <button class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Tickets.Any())
                { <tr><td colspan="9" class="text-center py-5 text-muted">
                    <i class="bi bi-ticket-perforated" style="font-size:2rem;display:block;margin-bottom:8px;"></i>No tickets found
                </td></tr> }
            </tbody>
        </table>
    </div>
</div>
